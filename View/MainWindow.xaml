<Window x:Class="BibliotecaWPF.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:models="clr-namespace:BibliotecaWPF.Models"
        xmlns:conv="clr-namespace:BibliotecaWPF.Converters"
        mc:Ignorable="d"
        Title="Biblioteca"
        Height="700"
        Width="1530">
    <Window.Resources>

        <!-- Stati Prestito -->
        <ObjectDataProvider x:Key="StatoPrestitoEnum"
                            MethodName="GetValues"
                            ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="models:StatoPrestito"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>

        <!-- Converter icone -->
        <conv:StatoPrestitoToIconConverter x:Key="IconConverter"/>

        <!-- Converter colori -->
        <conv:StatoPrestitoToColorConverter x:Key="ColorConverter"/>


    </Window.Resources>

    <Grid Margin="10">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="4*"/>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>

        <!-- FORM LIBRO -->
        <StackPanel Grid.Column="1"
                    Margin="10"
                    DataContext="{Binding LibroForm}">
            <TextBlock>
                <Bold>FORM INSERIMENTO LIBRO</Bold>
            </TextBlock>
            <TextBlock Text="Titolo"/>
            <TextBox Margin="5"
                     Text="{Binding Titolo, UpdateSourceTrigger=PropertyChanged}"/>

            <TextBlock Text="Autore"/>
            <TextBox Margin="5"
                     Text="{Binding Autore, UpdateSourceTrigger=PropertyChanged}"/>

            <TextBlock Text="ISBN"/>
            <TextBox Margin="5"
                     Text="{Binding Isbn, UpdateSourceTrigger=PropertyChanged}"/>

            <TextBlock Text="Anno pubblicazione"/>
            <TextBox Margin="5"
                     Text="{Binding AnnoPubblicazione, UpdateSourceTrigger=PropertyChanged}"/>

            <TextBlock Text="Genere"/>
            <TextBox Margin="5"
                     Text="{Binding Genere, UpdateSourceTrigger=PropertyChanged}"/>
            <Label Content="Durata prestito (giorni)"/>
            <TextBox Margin="5"
                     Text="{Binding DurataPrestito, UpdateSourceTrigger=PropertyChanged}"/>
            <TextBlock Text="Stato Prestito"/>

            <ComboBox Margin="5"
                      ItemsSource="{Binding Source={StaticResource StatoPrestitoEnum}}"
                      SelectedItem="{Binding Stato,
                                             Mode=TwoWay,
                                             UpdateSourceTrigger=PropertyChanged}"/>
            <Button Content="Salva"
                    Margin="10"
                    Command="{Binding SalvaCommand}"/>

        </StackPanel>

        <!-- Form inserimento dati socio -->
        <StackPanel Grid.Column="0"
            Margin="10"
            DataContext="{Binding SocioForm}">

            <TextBlock>
        <Bold>FORM INSERIMENTO SOCIO</Bold>
            </TextBlock>

            <TextBlock Text="Nome"/>
            <TextBox Margin="5"
             Text="{Binding Nome, UpdateSourceTrigger=PropertyChanged}"/>

            <TextBlock Text="Cognome"/>
            <TextBox Margin="5"
             Text="{Binding Cognome, UpdateSourceTrigger=PropertyChanged}"/>

            <TextBlock Text="ID"/>
            <TextBox Margin="5"
             Text="{Binding Id, UpdateSourceTrigger=PropertyChanged}"/>

            <TextBlock Text="Email"/>
            <TextBox Margin="5"
             Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"/>

            <Button Content="Salva"
            Margin="10"
            Command="{Binding SalvaCommand}"/>

        </StackPanel>

        <!-- elenco libri -->
        <DataGrid Grid.Column="2"
                  Margin="10"
                  ItemsSource="{Binding Libri}"
                  SelectedItem="{Binding LibroSelezionato}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True">

            <DataGrid.Columns>

                <DataGridTextColumn Header="Titolo"
                                    Binding="{Binding Titolo}" />

                <DataGridTextColumn Header="Autore"
                                    Binding="{Binding Autore}" />

                <DataGridTextColumn Header="ISBN"
                                    Binding="{Binding Isbn}" />

                <DataGridTextColumn Header="Anno"
                                    Binding="{Binding AnnoPubblicazione}" />

                <DataGridTextColumn Header="Genere"
                                    Binding="{Binding Genere}" />

                <DataGridTemplateColumn Header="Stato">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding StatoPrestito}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Padding="5"
                       Background="{Binding StatoPrestito, 
                                   Converter={StaticResource ColorConverter}}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Durata">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding DurataPrestito}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Padding="5"
                       Background="{Binding StatoPrestito, 
                                   Converter={StaticResource ColorConverter}}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Icona">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding StatoPrestito,
                                                      Converter={StaticResource IconConverter}}"
                                       FontSize="16"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
        <Button Content="Rimuovi libro"
                Style="{StaticResource DangerButton}"
                Width="140"
                Height="40"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="10"
                Grid.Column="2"
                Command="{Binding RimuoviCommand}"/>

        <Button Content="Svuota elenco"
                Style="{StaticResource DangerButton}"
                Width="140"
                Height="40"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                Margin="10"
                Grid.Column="2"
                Command="{Binding SvuotaLibriCommand}"/>

        <!-- Dashboard Statistiche -->
        <ItemsControl Grid.Column="3"
              Margin="10"
              ItemsSource="{Binding DashBoard.Cards}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>

            <ItemsControl.ItemTemplate>
                <DataTemplate>

                    <Border Width="140"
                    Height="80"
                    Margin="6"
                    Background="White"
                    BorderBrush="LightGray"
                    BorderThickness="1">

                        <StackPanel VerticalAlignment="Center"
                            HorizontalAlignment="Center">

                            <TextBlock Text="{Binding Titolo}"
                               FontSize="11"
                               Foreground="Black"
                               HorizontalAlignment="Center"/>

                            <TextBlock Text="{Binding Valore}"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="Black"
                               HorizontalAlignment="Center"/>

                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Grid Grid.Column="4" Margin="10">

            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <!-- GRAFICO -->
            <ItemsControl Grid.Row="0"
              ItemsSource="{Binding DashBoard.Cards}">

                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Vertical"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="40"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                           Text="{Binding Titolo}"
                           FontSize="10"/>

                            <Border Grid.Column="1"
                        Height="20"
                        HorizontalAlignment="Left"
                        Width="{Binding Valore}"
                        Background="#4A90D9"
                        CornerRadius="3"/>

                            <TextBlock Grid.Column="2"
                           Text="{Binding Valore}"
                           FontSize="10"
                           FontWeight="Bold"/>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
    </Grid>
</Window>